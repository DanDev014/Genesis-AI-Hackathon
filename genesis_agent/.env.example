# Copy to .env and fill in the values you want.
# Nothing here is strictly required — Kora runs offline with none of these set.

# ---------- Neon / Postgres ----------
# Paste the pooled connection string from your Neon console.
# If unset OR unreachable, Kora falls back to file storage automatically.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------- QuickBooks ----------
# QUICKBOOKS_MODE=sandbox           # unset or "simulated" = safe demo
# QUICKBOOKS_CLIENT_ID=...
# QUICKBOOKS_CLIENT_SECRET=...
# QUICKBOOKS_REFRESH_TOKEN=...
# QUICKBOOKS_REALM_ID=...

# ---------- LLM ----------
# Used only by the brief generator. Without a key, briefs use a deterministic
# template — the meter at /tokens will show mode=mock and $0 spend.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_FAST=claude-haiku-4-5
# LLM_SMART=claude-sonnet-4-5

# ---------- AI feedback loop ----------
# Points at the Flask backend's feedback-examples endpoint. When set,
# transcript extraction fetches recent won/lost proposals + human edits and
# feeds them back into the prompt as calibration context. Unset = no-op,
# zero added latency.
# FEEDBACK_API_URL=http://localhost:5000/api/proposals/feedback-examples

# ---------- Native Fathom webhook ----------
# The whsec_... secret Fathom hands you when you register a real webhook
# (Settings -> API Access -> Add Webhook) against /webhook/fathom/native.
# Unset = that endpoint rejects every request (fails closed, not open).
# FATHOM_WEBHOOK_SECRET=whsec_...

# ---------- Flask bridge (native webhook -> real proposal/quote/summary) ----------
# Without these two, /webhook/fathom/native still verifies signatures and
# extracts the transcript, but has nowhere to deliver the result — it
# returns {"ok": false, "reason": "...not configured..."} instead of
# silently doing nothing or writing to a local orphan record.
# Base URL of the Flask backend's API (same value as the frontend's
# API_BASE_URL).
# FLASK_API_URL=http://localhost:5000/api
# An existing user_id from Flask's `users` table — there's no human logged
# in during an automated webhook, so every proposal/quote/summary/client
# this creates gets attributed to this account. Pick whichever real user
# should "own" AI-captured records (e.g. a shared team account, or just
# your own id for now).
# GENESIS_SYSTEM_USER_ID=1001
