# Copy to .env and fill in the values you want.
# Nothing here is strictly required — Kora runs offline with none of these set.

# ---------- Neon / Postgres ----------
# Paste the pooled connection string from your Neon console.
# If unset OR unreachable, Kora falls back to file storage automatically.
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# ---------- QuickBooks ----------
# QUICKBOOKS_MODE=sandbox           # unset or "simulated" = safe demo
# QUICKBOOKS_CLIENT_ID=...
# QUICKBOOKS_CLIENT_SECRET=...
# QUICKBOOKS_REFRESH_TOKEN=...
# QUICKBOOKS_REALM_ID=...

# ---------- LLM ----------
# Used only by the brief generator. Without a key, briefs use a deterministic
# template — the meter at /tokens will show mode=mock and $0 spend.
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_FAST=claude-haiku-4-5
# LLM_SMART=claude-sonnet-4-5
