FLASK_APP=run.py
FLASK_ENV=development

SECRET_KEY=
JWT_SECRET_KEY=

DATABASE_URL=
OPENAI_API_KEY=

# ---------- Transactional email (proposal "Send to client") ----------
# Sign up at resend.com, generate an API key. Without it, sending a
# proposal fails with a clear "email isn't configured yet" error instead
# of silently doing nothing.
RESEND_API_KEY=
# Must be "Name <address>" at a domain verified in Resend, or Resend's own
# onboarding@resend.dev sandbox sender (which can only deliver to the
# Resend account's own verified email — fine for testing, not for real use).
MAIL_FROM=Tafsiri <onboarding@resend.dev>
# Base URL of the deployed frontend — used to build the public share link
# emailed to clients (https://yourapp.com/p/<token>).
PUBLIC_APP_URL=http://localhost:3000

# ---------- Outbound webhook (proposal/quote sent) ----------
# Optional. If set, we POST a JSON event here whenever a proposal is sent
# or a quote's status is changed to "sent" — point it at a Slack incoming
# webhook, a Zapier "Catch Hook" step, etc. Leave blank to disable.
OUTBOUND_WEBHOOK_URL=
# Optional. If set, every outbound webhook is signed with HMAC-SHA256 and
# sent as the X-Tafsiri-Signature: sha256=<hex> header, so the receiver can
# verify it actually came from us.
OUTBOUND_WEBHOOK_SECRET=