FLASK_APP=run.py
FLASK_ENV=development

SECRET_KEY=
JWT_SECRET_KEY=

DATABASE_URL=
OPENAI_API_KEY=

# ---------- Transactional email (proposal "Send to client") ----------
# Sign up at resend.com, generate an API key. Without it, sending a
# proposal fails with a clear "email isn't configured yet" error instead
# of silently doing nothing.
RESEND_API_KEY=
# Must be "Name <address>" at a domain verified in Resend, or Resend's own
# onboarding@resend.dev sandbox sender (which can only deliver to the
# Resend account's own verified email — fine for testing, not for real use).
MAIL_FROM=Kora AI <onboarding@resend.dev>
# Base URL of the deployed frontend — used to build the public share link
# emailed to clients (https://yourapp.com/p/<token>).
PUBLIC_APP_URL=http://localhost:3000